<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- ========================================================================
       DhdBridge.vcxproj
       C++/CLI managed wrapper DLL for the DLL Hijacking Defense System.
       Targets: x64 | Release only (no x86, no Debug for production).
       Requires: VS 2022 Build Tools with VC++ workload + C++/CLI component.
  ======================================================================== -->

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <RootNamespace>DhdBridge</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <Keyword>ManagedCProj</Keyword>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <!-- CLR support — required for C++/CLI -->
    <CLRSupport>NetCore</CLRSupport>
    <TargetFrameworkIdentifier>.NETCoreApp</TargetFrameworkIdentifier>
    <TargetFrameworkVersion>v8.0</TargetFrameworkVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseOfMfc>false</UseOfMfc>
    <CharacterSet>Unicode</CharacterSet>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />

  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatforms" />
  </ImportGroup>

  <PropertyGroup Label="UserMacros" />

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <OutDir>$(MSBuildProjectDirectory)\..\build\DhdBridge\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\..\build\DhdBridge\obj\$(Configuration)\</IntDir>
    <TargetName>DhdBridge</TargetName>
    <TargetExt>.dll</TargetExt>
    <!-- Where the native .lib files live after cmake build -->
    <NativeLibDir>C:\build\dhd\lib\Release\</NativeLibDir>
    <!-- Where the native headers live -->
    <NativeIncDirs>
      $(MSBuildProjectDirectory)\..\dll-hijack-defense\core;
      $(MSBuildProjectDirectory)\..\dll-hijack-defense\intelligence;
      $(MSBuildProjectDirectory)\..\dll-hijack-defense\monitor;
      $(MSBuildProjectDirectory)\..\dll-hijack-defense\audit;
      $(MSBuildProjectDirectory)\..\dll-hijack-defense\shared
    </NativeIncDirs>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <!-- C++17 for native code; /clr enables managed compilation -->
      <LanguageStandard>stdcpp17</LanguageStandard>
      <CompileAsManaged>NetCore</CompileAsManaged>
      <!-- /GS and /sdl are incompatible with /clr for managed files — disabled -->
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <AdditionalIncludeDirectories>$(NativeIncDirs);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>
        NOMINMAX;
        WIN32_LEAN_AND_MEAN;
        UNICODE;
        _UNICODE;
        WINVER=0x0A00;
        _WIN32_WINNT=0x0A00;
        %(PreprocessorDefinitions)
      </PreprocessorDefinitions>
      <WarningLevel>Level3</WarningLevel>
      <!-- /WX off for /clr — CLR headers produce warnings we can't control -->
      <TreatWarningAsError>false</TreatWarningAsError>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <ExceptionHandling>Async</ExceptionHandling>
    </ClCompile>

    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <!-- Native static libs from the cmake build -->
      <AdditionalDependencies>
        $(NativeLibDir)core.lib;
        $(NativeLibDir)intelligence.lib;
        $(NativeLibDir)monitor.lib;
        $(NativeLibDir)audit.lib;
        $(NativeLibDir)shared.lib;
        wintrust.lib;
        crypt32.lib;
        bcrypt.lib;
        advapi32.lib;
        shlwapi.lib;
        psapi.lib;
        imagehlp.lib;
        tdh.lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
      <AdditionalLibraryDirectories>$(NativeLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <!-- DEP + ASLR — same as native project -->
      <DataExecutionPrevention>true</DataExecutionPrevention>
      <RandomizedBaseAddress>true</RandomizedBaseAddress>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClInclude Include="DhdBridge.h" />
  </ItemGroup>

  <ItemGroup>
    <ClCompile Include="DhdBridge.cpp" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />

</Project>
