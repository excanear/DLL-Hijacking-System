<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DhdGui</RootNamespace>
    <AssemblyName>DhdGui</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc5.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <!-- C++/CLI bridge DLL reference -->
  <ItemGroup>
    <Reference Include="DhdBridge">
      <HintPath>..\build\DhdBridge\Release\DhdBridge.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Copy DhdBridge.dll to output directory -->
  <ItemGroup>
    <Content Include="..\build\DhdBridge\Release\DhdBridge.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>DhdBridge.dll</Link>
    </Content>
  </ItemGroup>

  <!-- V-13: Copy bootstrap_hashdb.exe — path resolved via MSBuild property (no hardcoded absolute path) -->
  <Target Name="CopyBootstrapHashDb" AfterTargets="Build">
    <PropertyGroup>
      <!-- Resolves to <workspace>\build\dhd\bin\Release\bootstrap_hashdb.exe regardless of clone location -->
      <_BootstrapSrc>$(MSBuildThisFileDirectory)..\build\dhd\bin\Release\bootstrap_hashdb.exe</_BootstrapSrc>
    </PropertyGroup>
    <Copy SourceFiles="$(_BootstrapSrc)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_BootstrapSrc)')" />
    <Warning Text="bootstrap_hashdb.exe não encontrado em $(_BootstrapSrc). Execute o build nativo primeiro."
             Condition="!Exists('$(_BootstrapSrc)')" />
  </Target>

</Project>
