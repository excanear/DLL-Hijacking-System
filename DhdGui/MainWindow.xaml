<Window x:Class="DhdGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:views="clr-namespace:DhdGui.Views"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="DLL Hijacking Defense System"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="900">

    <ui:NavigationView x:Name="NavView"
                       PaneTitle="DHD"
                       IsSettingsVisible="False"
                       IsPaneOpen="True"
                       OpenPaneLength="200"
                       SelectionChanged="NavView_SelectionChanged">

        <ui:NavigationView.MenuItems>
            <ui:NavigationViewItem Content="Dashboard"    Tag="Dashboard">
                <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE80F;"/></ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Content="Monitor RT"   Tag="Monitor">
                <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xEC4E;"/></ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Content="Validar DLL"  Tag="Validate">
                <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE9D9;"/></ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Content="Audit Scanner" Tag="Audit">
                <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE773;"/></ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Content="Logs"          Tag="Logs">
                <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE8A5;"/></ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Content="Configurações" Tag="Settings">
                <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE713;"/></ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
        </ui:NavigationView.MenuItems>

        <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden" />
    </ui:NavigationView>
</Window>
