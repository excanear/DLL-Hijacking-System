<Page x:Class="DhdGui.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:vm="clr-namespace:DhdGui.ViewModels"
      xmlns:conv="clr-namespace:DhdGui.Converters"
      Title="Dashboard">

    <Page.Resources>
        <conv:SeverityToColorConverter x:Key="SevColor"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="1100">

            <!-- Status card -->
            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                    CornerRadius="8" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Status do Sistema" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <TextBlock Text="{Binding SystemStatus}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding LastEventTime, StringFormat='Último evento: {0}'}"
                                   FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Quick action buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Iniciar" Command="{Binding StartSystemCommand}"
                                Style="{StaticResource AccentButtonStyle}" Margin="4,0"/>
                        <Button Content="Parar"   Command="{Binding StopSystemCommand}" Margin="4,0"/>
                        <Button Content="Flush Log" Command="{Binding FlushLogCommand}" Margin="4,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MiniCards 2×2 -->
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource MiniCardStyle}" Margin="0,0,8,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SessionValidations}" FontSize="32" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="DLLs Validadas" Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MiniCardStyle}" Margin="8,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SessionBlocks}" FontSize="32" FontWeight="Bold"
                                   HorizontalAlignment="Center" Foreground="OrangeRed"/>
                        <TextBlock Text="Bloqueios" Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MiniCardStyle}" Margin="8,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding FindingCount}" FontSize="32" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Monitor Findings" Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MiniCardStyle}" Margin="8,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding DroppedEvents}" FontSize="32" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Eventos Descartados" Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Recent events feed -->
            <TextBlock Text="Eventos Recentes" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,8"/>
            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                    CornerRadius="8" Padding="4">
                <ListView ItemsSource="{Binding RecentEvents}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="320">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                         Fill="{Binding Severity, Converter={StaticResource SevColor}}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                           VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="{Binding DllPath}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="3" Text="{Binding Action}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontSize="11"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
