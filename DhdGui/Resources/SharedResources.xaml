<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:DhdGui.Converters">

    <!-- Shared converters -->
    <conv:BlockReasonConverter      x:Key="BlockReasonConv"/>
    <conv:RiskLevelToColorConverter x:Key="RiskColor"/>
    <conv:ScoreToColorConverter     x:Key="ScoreColor"/>
    <conv:SeverityToColorConverter  x:Key="SevColor"/>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <!-- Bool → "Sim" / "Não" -->
    <conv:BoolToStringConverter x:Key="BoolToYesNo" TrueValue="Sim" FalseValue="Não"/>

    <!-- Bool → ETW / Polling -->
    <conv:BoolToStringConverter x:Key="BoolToEtwString" TrueValue="ETW" FalseValue="Polling"/>

    <!-- Bool → padlock unicode -->
    <conv:BoolToStringConverter x:Key="BoolToLock" TrueValue="🔒" FalseValue="🔓"/>

    <!-- Bool → green/red brush for padlock -->
    <conv:BoolToColorConverter x:Key="BoolToLockColor" TrueColor="SeaGreen" FalseColor="OrangeRed"/>

    <!-- Invert bool -->
    <conv:InvertBoolConverter x:Key="InvertBool"/>

    <!-- Null-or-empty string → Collapsed -->
    <conv:NullOrEmptyToCollapsedConverter x:Key="NullOrEmptyToCollapsed"/>

    <!-- Full path → filename only -->
    <conv:FileNameConverter x:Key="FileNameConverter"/>

    <!-- Mini card style -->
    <Style x:Key="MiniCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="20,16"/>
        <Setter Property="Margin" Value="0,0,0,0"/>
    </Style>

</ResourceDictionary>
